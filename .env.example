# GEMINI_API_KEY / GEMINI_API_KEYS: Required for Gemini AI API calls.
# Supports multiple keys separated by commas or newlines for automatic quota rotation.
# AI Studio automatically injects GEMINI_API_KEY at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEYS=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PIN: PIN protecting /superadmin (defaults to 1234 if unset).
ADMIN_PIN=

# SESSION_SECRET: Optional secret for signing admin session tokens.
SESSION_SECRET=

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Optional Supabase persistence over table voicelab_storage (key, data, updated_at).
# Falls back to local storage if unset.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# F5_TTS_GPU_URL: Optional external Gradio/FastAPI GPU endpoint for Zero-Shot F5-TTS cloning.
F5_TTS_GPU_URL=

